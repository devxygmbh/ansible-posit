{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>devxy/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/db_drivers/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+) datasource=(?<datasource>\\S+)\\n\\w+:[ \\t]+[\"']?(?<currentValue>[^\"'\\s]+)"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Posit drivers come from the Cloudsmith apt repository, which replaced the retired downloads.json host.",
      "matchDepNames": ["rstudio-drivers"],
      "registryUrls": [
        "https://dl.posit.co/public/pro/deb/ubuntu?suite=noble&components=main&binaryArch=amd64"
      ]
    }
  ],
  "customDatasources": {
    "oracle-instantclient": {
      "defaultRegistryUrlTemplate": "https://yum.oracle.com/repo/OracleLinux/OL9/oracle/instantclient/x86_64/",
      "format": "html",
      "transformTemplates": [
        "{\"releases\": $distinct($map($match($, /oracle-instantclient\\d+\\.\\d+-basic-(\\d+\\.\\d+\\.\\d+\\.\\d+\\.\\d+)-/), function($v) { {\"version\": $v.groups[0]} }))}"
      ]
    }
  }
}
