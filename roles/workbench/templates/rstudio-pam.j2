{% if ansible_facts['os_family'] == 'RedHat' %}
# from https://support.posit.co/hc/en-us/articles/360016587973-Integrating-RStudio-Workbench-RStudio-Server-Pro-with-Active-Directory-using-CentOS-RHEL
#%PAM-1.0
{% if workbench_server_auth_openid | int == 1 %}
# OIDC/SSO mode: allow the Workbench server (running as root) to satisfy the PAM
# auth/account stacks without a password when it opens sessions on behalf of
# SSO-authenticated users. Do NOT enable rootok in password-auth mode, or any
# password is accepted because the auth helper itself runs as root.
auth sufficient pam_rootok.so
{% endif %}
auth [user_unknown=ignore success=ok ignore=ignore default=bad] pam_securetty.so
auth substack system-auth
auth include postlogin
account required pam_nologin.so
# Create the user's home directory before Workbench accesses /home/$USER (rworkspaces touches
# the home before the PAM session stack runs, so pam_oddjob_mkhomedir in session is too late).
# Must precede the rootok shortcut below, otherwise the account stack short-circuits.
account required pam_exec.so seteuid /usr/local/sbin/ensure-home-dir.sh
{% if workbench_server_auth_openid | int == 1 %}
account sufficient pam_rootok.so
{% endif %}
account include system-auth
password include system-auth
# pam_selinux.so close should be the first session rule
session required pam_selinux.so close
session optional pam_console.so
session required pam_mkhomedir.so skel=/etc/skel umask=0077
# pam_selinux.so open should only be followed by sessions to be executed in the user context
session required pam_selinux.so open
session required pam_namespace.so
session optional pam_keyinit.so force revoke
session include system-auth
session include postlogin
-session optional pam_ck_connector.so
{% else %}
# This module parses environment configuration file(s)
# and also allows you to use an extended config
# file /etc/security/pam_env.conf.
# parsing /etc/environment needs "readenv=1"
session    required   pam_env.so readenv=1

# Locale variables are also kept into /etc/default/locale in etch
# reading this file *in addition to /etc/environment* does not hurt
session    required   pam_env.so readenv=1 envfile=/etc/default/locale

session required pam_mkhomedir.so skel=/etc/skel umask=0077

# Enforces user limits defined in /etc/security/limits.conf
session    required   pam_limits.so

# The standard Unix authentication modules
@include common-auth
@include common-account
@include common-session
{% endif %}
